#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "fake steamcmd: $*" >&2
  exit 64
}

record_dir=/fixture/records
expected_home=/mnt/vrising/server/.docker-vrising/home
[[ $PWD == "$expected_home" ]] || fail "unexpected cwd: $PWD"
[[ ${HOME-} == "$expected_home" ]] || fail "unexpected HOME: ${HOME-}"
[[ ${LANG-} == en_US.UTF-8 ]] || fail "unexpected LANG: ${LANG-}"
[[ ${LC_ALL-} == en_US.UTF-8 ]] || fail "unexpected LC_ALL: ${LC_ALL-}"
[[ -d $record_dir ]] || fail 'record directory is unavailable'

mode=
if (( $# == 9 )) &&
  [[ $1 == +@sSteamCmdForcePlatformType && $2 == windows &&
     $3 == +login && $4 == anonymous &&
     $5 == +app_info_update && $6 == 1 &&
     $7 == +app_info_print && $8 == 1829350 && $9 == +quit ]]; then
  mode=remote
elif (( $# == 10 )) &&
  [[ $1 == +@sSteamCmdForcePlatformType && $2 == windows &&
     $3 == +force_install_dir && $4 == /mnt/vrising/server &&
     $5 == +login && $6 == anonymous &&
     $7 == +app_update && $8 == 1829350 && $9 == validate && ${10} == +quit ]]; then
  mode=update
else
  fail 'unexpected argv'
fi

{
  printf 'mode=%s cwd=%q HOME=%q LANG=%q LC_ALL=%q argv=' "$mode" "$PWD" "$HOME" "$LANG" "$LC_ALL"
  printf '%q ' "$@"
  printf '\n'
} >>"$record_dir/steamcmd.accepted"

if [[ $mode == remote ]]; then
	printf '"1829350"\n{\n\t"depots"\n\t{\n\t\t"1829351"\n\t\t{\n\t\t\t"manifests"\n\t\t\t{\n\t\t\t\t"public"\n\t\t\t\t{\n\t\t\t\t\t"gid"\t\t"515151"\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t"branches"\n\t\t{\n\t\t\t"public"\n\t\t\t{\n\t\t\t\t"buildid"\t\t"424242"\n\t\t\t}\n\t\t}\n\t}\n}\n'
  exit 0
fi

mkdir -p /mnt/vrising/server/steamapps
mkdir -p /mnt/vrising/server/VRisingServer_Data/StreamingAssets/Settings
printf '{}\n' >/mnt/vrising/server/VRisingServer_Data/StreamingAssets/Settings/ServerHostSettings.json
printf '{}\n' >/mnt/vrising/server/VRisingServer_Data/StreamingAssets/Settings/ServerGameSettings.json
: >/mnt/vrising/server/VRisingServer.exe
printf '1604030\n' >/mnt/vrising/server/steam_appid.txt
cat >/mnt/vrising/server/steamapps/appmanifest_1829350.acf <<'EOF'
"AppState"
{
    "appid"        "1829350"
    "buildid"      "424242"
    "StateFlags"   "4"
    "InstalledDepots"
    {
        "1829351"
        {
            "manifest" "515151"
        }
    }
}
EOF
